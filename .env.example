# For Docker Compose:  cp .env.example .env       (Docker reads .env automatically)
# For local dev:       cp .env.example .env.local  (Next.js reads .env.local)
# Both files are gitignored.
#
# Dev:  docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch
# Prod: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── Supabase ──────────────────────────────────────────────────────────────────
# Option A — Supabase Cloud (recommended for dev without Docker):
#   Create a free project at https://supabase.com, then copy the values from
#   Project Settings → API.
#
# Option B — Self-hosted via Docker Compose:
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000  (Kong gateway)
#   Run `docker compose up` — the stack starts automatically.

# Dev (Docker): set to http://localhost:8000
# Prod (Docker): set to your public Kong URL e.g. https://api.yourdomain.com or http://<ip>:8000
#   This value is baked into the Next.js build — rebuild the image if you change it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only URL — only needed when the app runs inside Docker
# (inside the container, localhost doesn't reach Kong; use the internal hostname instead).
# Leave blank for local dev with Supabase Cloud (NEXT_PUBLIC_SUPABASE_URL is used as fallback).
SUPABASE_URL=

# ── Prod-only ─────────────────────────────────────────────────────────────────
# Public URL of the app itself (used by GoTrue for redirect URLs)
SITE_URL=
# Same as NEXT_PUBLIC_SUPABASE_URL — used by the auth service
API_EXTERNAL_URL=

# ── Docker Compose / self-hosted Supabase only ────────────────────────────────
# These are only needed when running `docker compose up`.
# For Supabase Cloud users, leave these blank.

# Strong random password for Postgres (e.g. openssl rand -base64 32)
POSTGRES_PASSWORD=o9TmVNuEZWyF2x7i7qqRCuzuv591JWgtusimIR47NUo=

# JWT secret — must be at least 32 characters (e.g. openssl rand -base64 32)
JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET.
# Generate them at https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# or use the Supabase CLI: `supabase start` will print them.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# If set, listing generation uses Claude; otherwise it uses the template fallback.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for listing generation. Default: claude-haiku-4-5 (fast + cheap).
ANTHROPIC_MODEL=claude-haiku-4-5
