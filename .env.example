# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# Optional. If set, listing generation uses Claude; otherwise it uses the template fallback.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for listing generation. Default: claude-haiku-4-5 (fast + cheap).
ANTHROPIC_MODEL=claude-haiku-4-5
