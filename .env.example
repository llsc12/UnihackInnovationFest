# Copy this file to .env.local and fill in your values.
# .env.local is gitignored.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Option A — Supabase Cloud (recommended for dev without Docker):
#   Create a free project at https://supabase.com, then copy the values from
#   Project Settings → API.
#
# Option B — Self-hosted via Docker Compose:
#   NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000  (Kong gateway)
#   Run `docker compose up` — the stack starts automatically.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Docker Compose / self-hosted Supabase only ────────────────────────────────
# These are only needed when running `docker compose up`.
# For Supabase Cloud users, leave these blank.

# Strong random password for Postgres (e.g. openssl rand -base64 32)
POSTGRES_PASSWORD=

# JWT secret — must be at least 32 characters (e.g. openssl rand -base64 32)
JWT_SECRET=

# ANON_KEY and SERVICE_ROLE_KEY are JWTs signed with JWT_SECRET.
# Generate them at https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# or use the Supabase CLI: `supabase start` will print them.
ANON_KEY=
SERVICE_ROLE_KEY=

# ── Anthropic (optional) ──────────────────────────────────────────────────────
# If set, listing generation uses Claude; otherwise it uses the template fallback.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model used for listing generation. Default: claude-haiku-4-5 (fast + cheap).
ANTHROPIC_MODEL=claude-haiku-4-5
